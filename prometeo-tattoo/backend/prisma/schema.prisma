generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String
  role           Role            @default(CUSTOMER)
  orders         Order[]
  cart           Cart?
  sales          Sale[]
  expenses       Expense[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum Role {
  CUSTOMER
  ADMIN
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  image    String?
  products Product[]
}

model Product {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  description    String
  price          Float
  comparePrice   Float?
  onSale         Boolean         @default(false)
  stock          Int             @default(0)
  images         String[]
  brand          String
  featured       Boolean         @default(false)
  category       Category        @relation(fields: [categoryId], references: [id])
  categoryId     String
  cartItems      CartItem[]
  orderItems     OrderItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([featured])
}

model Cart {
  id     String     @id @default(uuid())
  user   User       @relation(fields: [userId], references: [id])
  userId String     @unique
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model Order {
  id          String      @id @default(uuid())
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  items       OrderItem[]
  total       Float
  status      OrderStatus @default(PENDING)
  address     String
  phone       String?
  notes       String?
  mpPaymentId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
  name      String
}

model StoreConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── PUNTO DE VENTA (mostrador) ─────────────────────────────────────────────
// Separado de Order a propósito: Order es el checkout online (carrito +
// MercadoPago). Sale es la venta presencial que carga el admin en el
// mostrador — mismo descuento atómico de stock, sin carrito ni dirección de
// envío ni pago online.

model Sale {
  id            String        @id @default(uuid())
  code          String        @unique
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  items         SaleItem[]
  total         Float
  paymentMethod PaymentMethod @default(EFECTIVO)
  notes         String?
  // Anular no borra la venta (se pierde el registro para auditoría) — la
  // marca como anulada, restaura el stock y se excluye de los totales de
  // ingresos, pero el recibo original sigue existiendo.
  voided        Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

model SaleItem {
  id        String  @id @default(uuid())
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
  name      String

  @@index([saleId])
  @@index([productId])
}

// ─── CONTROL DE GASTOS ──────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String?
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

// ─── AUDITORÍA DE STOCK ─────────────────────────────────────────────────────
// Registro unificado de todo cambio de stock (venta mostrador, venta
// online, cancelación, carga manual) — para poder responder "¿por qué
// cambió el stock de este producto?" sin tener que cruzar Order y Sale a
// mano.

model StockMovement {
  id        String            @id @default(uuid())
  product   Product           @relation(fields: [productId], references: [id])
  productId String
  type      StockMovementType
  delta     Int
  saleId    String?
  orderId   String?
  user      User              @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime          @default(now())

  @@index([productId, createdAt])
}

enum StockMovementType {
  SALE_POS
  SALE_ONLINE
  RESTOCK
  ADJUSTMENT
}
